&CONTROL
 calculation = 'scf',
 prefix = 'graphene',
 pseudo_dir = './',
 outdir = './tmp',
 tstress = .true.,
/
&SYSTEM
 ibrav = 0,
 nat = 2,
 ntyp = 1,
 ecutwfc = 90,
 ecutrho = 720,
 occupations = 'smearing',
 smearing = 'gauss',
 degauss = 0.01,
 assume_isolated = '2D',
 
/
&ELECTRONS
 conv_thr = 1.0d-9,
 mixing_beta = 0.5,
/
ATOMIC_SPECIES
 C 12.011 C.upf

CELL_PARAMETERS angstrom
2.466425429   0.000000000   0.000000000
  -1.233212714   2.135987078   0.000000000
   0.000000000   0.000000000  15.000000000

ATOMIC_POSITIONS angstrom
C                0.0000000000       -0.0000000000        7.5000000000
C                0.0000000000        1.4239913852        7.5000000000

K_POINTS automatic
20 20 1 0 0 0
